<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light glass. Silver material, gray text, yellow #FFC93C for key highlights only. -->
    <Color x:Key="C.Bg">#D9DADC</Color>
    <Color x:Key="C.Accent">#FFC93C</Color>
    <Color x:Key="C.Accent2">#FFC93C</Color>

    <SolidColorBrush x:Key="Bg" Color="#D9DADC"/>
    <SolidColorBrush x:Key="Backdrop" Color="#80F4F4F6"/>
    <SolidColorBrush x:Key="Sidebar" Color="#12000000"/>

    <SolidColorBrush x:Key="Surface" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="Elevated" Color="#FAF6F6F7"/>
    <SolidColorBrush x:Key="Hover" Color="#12000000"/>
    <SolidColorBrush x:Key="Line" Color="#1A000000"/>
    <SolidColorBrush x:Key="LineStrong" Color="#33000000"/>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.4"/>
        <GradientStop Color="#1F000000" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Text" Color="#16171A"/>
    <SolidColorBrush x:Key="Muted" Color="#4C4E53"/>
    <SolidColorBrush x:Key="Dimmed" Color="#86888C"/>

    <SolidColorBrush x:Key="Accent" Color="#FFC93C"/>
    <SolidColorBrush x:Key="AccentText" Color="#1F2023"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#14000000"/>
    <SolidColorBrush x:Key="AccentSofter" Color="#0A000000"/>
    <SolidColorBrush x:Key="OnAccent" Color="#2B2D31"/>

    <SolidColorBrush x:Key="Success" Color="#1F2023"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#12000000"/>
    <SolidColorBrush x:Key="Warn" Color="#55575C"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#12000000"/>
    <SolidColorBrush x:Key="Danger" Color="#9C2A22"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1A9C2A22"/>
    <SolidColorBrush x:Key="OnDanger" Color="#D9DADC"/>

    <SolidColorBrush x:Key="Mark" Color="#2B2D31"/>
    <SolidColorBrush x:Key="OnMark" Color="#E6E7E8"/>
    <SolidColorBrush x:Key="FolderIcon" Color="#55575C"/>
    <SolidColorBrush x:Key="Track" Color="#1F000000"/>
    <SolidColorBrush x:Key="TipBg" Color="#F22B2D31"/>
    <SolidColorBrush x:Key="MapFolder" Color="#B3A3A4A7"/>
    <SolidColorBrush x:Key="MapDim" Color="#D6D7D9"/>
    <SolidColorBrush x:Key="Scrim" Color="#55000000"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC93C" Offset="0"/><GradientStop Color="#FFC93C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC93C" Offset="0"/><GradientStop Color="#FFC93C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B2D31" Offset="0"/><GradientStop Color="#2B2D31" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroGlow" Color="#00000000"/>
    <Color x:Key="ShadowColor">#2B2D31</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.12</sys:Double>
</ResourceDictionary>
