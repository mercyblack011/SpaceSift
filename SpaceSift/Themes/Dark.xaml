<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark glass. Palette: gray #2B2D31, silver #D9DADC, yellow #FFC93C for key highlights only.
         Surfaces are translucent so the Windows Acrylic material shows through (solid fallback = Bg). -->
    <Color x:Key="C.Bg">#2B2D31</Color>
    <Color x:Key="C.Accent">#FFC93C</Color>
    <Color x:Key="C.Accent2">#FFC93C</Color>

    <!-- window -->
    <SolidColorBrush x:Key="Bg" Color="#2B2D31"/>              <!-- opaque fallback (no glass) -->
    <SolidColorBrush x:Key="Backdrop" Color="#5C1E2024"/>      <!-- tint over the acrylic material -->
    <SolidColorBrush x:Key="Sidebar" Color="#47000000"/>       <!-- heavier, darker material: structure -->

    <!-- glass surfaces -->
    <SolidColorBrush x:Key="Surface" Color="#4D4B4E58"/>
    <SolidColorBrush x:Key="Surface2" Color="#3D5A5D66"/>
    <SolidColorBrush x:Key="Elevated" Color="#FA36383E"/>      <!-- popups/menus: nearly opaque -->
    <SolidColorBrush x:Key="Hover" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="LineStrong" Color="#47FFFFFF"/>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.35"/>
        <GradientStop Color="#0FFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- text -->
    <SolidColorBrush x:Key="Text" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="Muted" Color="#B8BABE"/>
    <SolidColorBrush x:Key="Dimmed" Color="#8A8C91"/>

    <!-- highlight (key places only) -->
    <SolidColorBrush x:Key="Accent" Color="#FFC93C"/>
    <SolidColorBrush x:Key="AccentText" Color="#ECEDEE"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="AccentSofter" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#2B2D31"/>

    <SolidColorBrush x:Key="Success" Color="#ECEDEE"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Warn" Color="#A9AAAD"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Danger" Color="#F0A59C"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1FF0A59C"/>
    <SolidColorBrush x:Key="OnDanger" Color="#2B2D31"/>

    <SolidColorBrush x:Key="Mark" Color="#D9DADC"/>
    <SolidColorBrush x:Key="OnMark" Color="#2B2D31"/>
    <SolidColorBrush x:Key="FolderIcon" Color="#BDBEC1"/>
    <SolidColorBrush x:Key="Track" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="TipBg" Color="#F51F2023"/>
    <SolidColorBrush x:Key="MapFolder" Color="#E01F2023"/>
    <SolidColorBrush x:Key="MapDim" Color="#3A3C41"/>
    <SolidColorBrush x:Key="Scrim" Color="#99000000"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC93C" Offset="0"/><GradientStop Color="#FFC93C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC93C" Offset="0"/><GradientStop Color="#FFC93C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9DADC" Offset="0"/><GradientStop Color="#D9DADC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroGlow" Color="#00000000"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.45</sys:Double>
</ResourceDictionary>
