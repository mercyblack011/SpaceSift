<Window x:Class="SpaceSift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SpaceSift.UI"
        Title="SpaceSift" Icon="Assets/app.ico" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- junk / leftover cards: hover lift + entrance animation -->
        <Style x:Key="LiftCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                    <Setter Property="Effect" Value="{StaticResource CardShadowHover}"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-3" Duration="0:0:0.22" EasingFunction="{StaticResource Ease}"/>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource Ease}"/>
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="SearchIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE721;"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= SIDEBAR ======================= -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,16">
                <!-- brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18">
                    <Image Source="Assets/mark.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SpaceSift" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Disk Studio" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- drive card with ring gauge -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <ComboBox x:Name="DriveBox"/>
                        <Grid Width="148" Height="148" Margin="0,16,0,10">
                            <ui:RingGauge x:Name="Gauge" Thickness="12" ArcBrush="{DynamicResource Accent}" TrackBrush="{DynamicResource Track}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="GaugePct" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="used" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="FREE" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SumFree" Text="–" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Success}"/>
                                <TextBlock x:Name="SumFreePct" Foreground="{DynamicResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,4">
                                <TextBlock Text="USED" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SumUsed" Text="–" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="SumUsedPct" Foreground="{DynamicResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="2,4">
                                <TextBlock Text="TOTAL" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SumTotal" Text="–" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="2,4">
                                <TextBlock Text="RESERVED" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SumReserved" Text="–" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- theme switch -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2}" CornerRadius="12" Padding="4" Margin="0,12,0,0">
                    <Button x:Name="ThemeButton" Style="{StaticResource Ghost}" Click="ThemeButton_Click" HorizontalContentAlignment="Stretch" Margin="0" Padding="10,8"
                            ToolTip="Switch between dark and light (Ctrl+T)">
                        <DockPanel Width="190">
                            <TextBlock x:Name="ThemeGlyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="15" Text="&#xE708;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+T" Foreground="{DynamicResource Dimmed}" FontSize="10.5" FontWeight="Normal" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeText" Text="Dark mode" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </Border>
                <TextBlock x:Name="SumScan" DockPanel.Dock="Bottom" Foreground="{DynamicResource Dimmed}" FontSize="11" TextWrapping="Wrap" Margin="6,0"/>

                <!-- navigation -->
                <StackPanel>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="NavList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="Clean Up" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="Apps" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="Disk Map" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="Files" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="Organize" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="Convert" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="15" Width="26"/><TextBlock Text="About" FontWeight="SemiBold"/></StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= CONTENT ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header + scan controls -->
            <DockPanel Margin="28,22,28,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="FastMode" Style="{StaticResource Switch}" Content="Fast mode" Margin="0,0,16,0"
                              ToolTip="Reads the NTFS Master File Table directly: much faster and exact sizes on disk. Needs administrator rights; falls back to a normal scan otherwise."/>
                    <Button x:Name="ForceButton" Click="ForceDeleteMenu_Click" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                            ToolTip="Force delete any file or folder, even if a program is using it (the program is closed first)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource EraserIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Force delete"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource Ghost}" Margin="0,0,6,0"
                            ToolTip="Refresh: find new drives, USB sticks and phones, update free space, junk and apps, and scan the shown drive again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Stop"/></StackPanel>
                    </Button>
                    <Button x:Name="ScanButton" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0" Padding="18,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Scan drive"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Clean Up" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="PageSub" Text="Free space safely in one click" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- progress + status -->
            <StackPanel Grid.Row="1" Margin="28,0,28,6">
                <!-- one progress bar for every long job (scan, clean, uninstall, force delete): 0–100% -->
                <DockPanel x:Name="ProgressRow" Opacity="0" Height="18">
                    <TextBlock x:Name="ProgressPct" DockPanel.Dock="Right" Text="0%" Width="48" TextAlignment="Right" FontWeight="Bold"
                               FontFamily="{StaticResource DisplayFont}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="ProgressTask" DockPanel.Dock="Left" Text="" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" Height="6" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           Text="Pick a drive and press Scan drive to map it."/>
            </StackPanel>

            <TabControl Grid.Row="2" x:Name="Tabs" Style="{StaticResource Pages}" Margin="28,6,28,22" SelectionChanged="Tabs_SelectionChanged">

                <!-- ======================= CLEAN UP ======================= -->
                <TabItem x:Name="TabClean" Header="Clean Up">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <!-- hero: no box, just a big number and the action (Apple: hierarchy from size + weight) -->
                        <DockPanel Margin="4,6,4,22">
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Button x:Name="JunkCleanButton" Style="{StaticResource SuccessBtn}" Click="JunkClean_Click" Padding="26,13" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="JunkCleanText" Text="Clean selected" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="JunkScanButton" Style="{StaticResource Ghost}" Click="JunkScan_Click" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Scan again" FontWeight="Normal"/></StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="JunkHeadline" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="54" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                    <TextBlock x:Name="JunkHeadSuffix" Text="looking for junk…" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,11"/>
                                </StackPanel>
                                <TextBlock x:Name="JunkSummary" Style="{StaticResource Sub}" FontSize="13.5" Text="Checking temp files, caches, the Recycle Bin and more."/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock x:Name="StatSafe" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/>
                                        <TextBlock Text="Safe to clean" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock x:Name="StatSelected" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/>
                                        <TextBlock Text="Selected" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="StatAfter" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Free after cleaning  " Foreground="{DynamicResource Muted}" FontSize="12"/>
                                            <TextBlock x:Name="StatAfterSub" Foreground="{DynamicResource Dimmed}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- one grouped glass list (Apple "inset grouped"), rows separated by hairlines -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="0,4" ClipToBounds="True">
                                    <ItemsControl x:Name="JunkList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,14,22,14" Margin="6,0">
                                                    <Grid>
                                                        <Border x:Name="RowHover" Background="{DynamicResource Hover}" CornerRadius="10" Margin="-14,-8,-16,-8" Opacity="0"/>
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="19" Width="30" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
                                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="110">
                                                                <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Dimmed}" HorizontalAlignment="Right" FontSize="11.5"/>
                                                            </StackPanel>
                                                            <Button x:Name="OpenLink" DockPanel.Dock="Right" Style="{StaticResource SkiperLink}" Content="Open location" Tag="{Binding}" Click="JunkOpen_Click"
                                                                    FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0" Opacity="0" Visibility="{Binding OpenVisibility}"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                                    <Border x:Name="Pill" CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource WarnSoft}" Visibility="Collapsed">
                                                                        <TextBlock Text="Check first" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                <TextBlock x:Name="StatusTb" Text="{Binding Status}" Foreground="{DynamicResource Dimmed}" FontSize="11.5" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Grid>
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard><Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Ease}"/>
                                                            </Storyboard></BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!-- hover: soft highlight fades in and the "Open location" link appears -->
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource Ease}"/>
                                                            <DoubleAnimation Storyboard.TargetName="OpenLink" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Ease}"/>
                                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Ease}"/>
                                                            <DoubleAnimation Storyboard.TargetName="OpenLink" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Ease}"/>
                                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Safety}" Value="Review">
                                                        <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cleaning…">
                                                        <Setter TargetName="StatusTb" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <DataTrigger.EnterActions><BeginStoryboard x:Name="CleanPulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="1" To="0.6" Duration="0:0:0.5"/>
                                                        </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="CleanPulse"/></DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Measuring…">
                                                        <DataTrigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetName="StatusTb" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6"/>
                                                        </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Foreground="{DynamicResource Dimmed}" FontSize="12" TextWrapping="Wrap" Margin="20,14,20,4"
                                           Text="Junk cleaning deletes for good and skips files in use. Turn on Fast mode and accept the admin prompt to clean Windows folders fully. For more space, remove apps you no longer use in Apps."/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ======================= APPS ======================= -->
                <TabItem x:Name="TabApps" Header="Apps">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="160"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="0.9*" MinHeight="160"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="UninstallButton" Style="{StaticResource DangerBtn}" Click="Uninstall_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Uninstall"/></StackPanel>
                                </Button>
                                <Button x:Name="AppFolderButton" Click="AppFolder_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Open folder"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Click="AppsRefresh_Click" ToolTip="Refresh">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Click="StoreApps_Click" Margin="0" ToolTip="Microsoft Store apps are removed in Windows Settings">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Store apps"/></StackPanel>
                                </Button>
                            </StackPanel>
                            <Grid Width="300" HorizontalAlignment="Left">
                                <TextBox x:Name="AppSearch" Padding="34,7,10,7" TextChanged="AppSearch_Changed" ToolTip="Search by name or publisher"/>
                                <TextBlock Style="{StaticResource SearchIcon}"/>
                            </Grid>
                            <TextBlock x:Name="AppsSummary" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource Muted}"/>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                            <ListView x:Name="AppList" ItemContainerStyle="{StaticResource AnimatedRow}" SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                                      GridViewColumnHeader.Click="AppHeader_Click" SelectionChanged="AppList_SelectionChanged" MouseDoubleClick="AppList_DoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="370">
                                            <GridViewColumnHeader Content="Program" Tag="Name"/>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="4,4">
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Surface2}" Margin="0,0,10,0">
                                                            <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="96">
                                            <GridViewColumnHeader Content="Size" Tag="Size"/>
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Right}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="96" DisplayMemberBinding="{Binding DateText}"><GridViewColumnHeader Content="Installed" Tag="Date"/></GridViewColumn>
                                        <GridViewColumn Width="120" DisplayMemberBinding="{Binding Version}"><GridViewColumnHeader Content="Version" Tag="Version"/></GridViewColumn>
                                        <GridViewColumn Width="420">
                                            <GridViewColumnHeader Content="Folder" Tag="Folder"/>
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding InstallLocation}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeNS"/>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12,14,6">
                            <TabControl x:Name="AppBottomTabs" Style="{StaticResource SegTabs}">
                                <TabItem x:Name="TabAppFiles" Header="Files of selected app">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="RelatedOpenButton" Click="RelatedOpen_Click" IsEnabled="False" Content="Open"/>
                                                <Button x:Name="RelatedExplorerButton" Click="RelatedExplorer_Click" IsEnabled="False" Content="Show in Explorer"/>
                                                <Button x:Name="RelatedDeleteButton" Click="RelatedDelete_Click" IsEnabled="False" Margin="0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,7,0" Foreground="{DynamicResource Danger}"/><TextBlock Text="Move to Recycle Bin"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="RelatedIcon" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="RelatedTitle" Text="Select an app above" Style="{StaticResource H2}"/>
                                                    <TextBlock x:Name="RelatedSummary" Style="{StaticResource Sub}" Text="Its install folder, app data, shortcuts and registry entry will be listed here."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                        <ListView x:Name="RelatedList" ItemContainerStyle="{StaticResource AnimatedRow}" SelectionMode="Extended" SelectionChanged="RelatedList_SelectionChanged" MouseDoubleClick="RelatedList_DoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Type" Width="200">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource FolderIcon}" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding Kind}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Size" Width="90">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Right}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Files" Width="96">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FilesText}" Style="{StaticResource Right}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Last used" Width="96" DisplayMemberBinding="{Binding DateText}"/>
                                                    <GridViewColumn Header="Location" Width="620" DisplayMemberBinding="{Binding Path}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </DockPanel>
                                </TabItem>
                                <TabItem x:Name="TabLeftovers" Header="Leftover folders">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="LeftoverScanButton" Click="LeftoverScan_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Find leftovers"/></StackPanel>
                                                </Button>
                                                <Button x:Name="LeftoverOpenButton" Content="Open" Click="LeftoverOpen_Click" IsEnabled="False"/>
                                                <Button x:Name="LeftoverDeleteButton" Click="LeftoverDelete_Click" IsEnabled="False" Margin="0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,7,0" Foreground="{DynamicResource Danger}"/><TextBlock Text="Move to Recycle Bin"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Leftover folders from removed apps" Style="{StaticResource H2}"/>
                                                <TextBlock x:Name="LeftoverSummary" Style="{StaticResource Sub}"
                                                           Text="Folders that match no installed program and haven't been used for 30+ days. Check each one before deleting."/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ListView x:Name="LeftoverList" ItemContainerStyle="{StaticResource AnimatedRow}" SelectionMode="Extended" SelectionChanged="LeftoverList_SelectionChanged">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Folder" Width="240">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{DynamicResource FolderIcon}" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Size" Width="90">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Right}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Where" Width="140" DisplayMemberBinding="{Binding Location}"/>
                                                    <GridViewColumn Header="Last used" Width="96" DisplayMemberBinding="{Binding DateText}"/>
                                                    <GridViewColumn Header="Full path" Width="560" DisplayMemberBinding="{Binding Path}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================= DISK MAP (tree view) ======================= -->
                <TabItem x:Name="TabTree" Header="Tree View">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="0.9*" MinHeight="140"/>
                        </Grid.RowDefinitions>
                        <!-- empty state: shown until a drive has been scanned -->
                        <Border x:Name="MapEmpty" Panel.ZIndex="10" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="40">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" FontSize="36" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="MapEmptyTitle" Text="Map your drive" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,8"/>
                                <TextBlock Text="Scan a drive to see which folders and file types take up the most space, as a tree, a chart and a map." Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                                <Button x:Name="MapEmptyButton" Style="{StaticResource Primary}" Click="Scan_Click" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24,11">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,9,0"/><TextBlock Text="Scan drive" FontSize="14"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*" MinWidth="320"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Padding="4" ClipToBounds="True">
                                <ListView x:Name="TreeList"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Item" SelectionMode="Extended"
                                          GridViewColumnHeader.Click="TreeHeader_Click" SelectionChanged="TreeList_SelectionChanged"
                                          MouseDoubleClick="TreeList_DoubleClick" KeyDown="TreeList_KeyDown"
                                          ContextMenuOpening="TreeList_ContextMenuOpening">
                                    <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AnimatedRow}">
                                            <Setter Property="MinHeight" Value="26"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDimmed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Dimmed}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="300">
                                                <GridViewColumnHeader Content="Folder" Tag="Name"/>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="9" Width="16" VerticalAlignment="Center"
                                                                       TextAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Expander_MouseDown" Background="Transparent" Foreground="{DynamicResource Muted}"/>
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource FolderIcon}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="128">
                                                <GridViewColumnHeader Content="% of Parent" Tag="Percent"/>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="60" Height="6" CornerRadius="3" Background="{DynamicResource Track}" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3" Background="{DynamicResource Muted}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding PercentText}" Margin="8,0,0,0" Foreground="{DynamicResource Muted}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="84">
                                                <GridViewColumnHeader Content="Size" Tag="Size"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size}" Style="{StaticResource Right}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="84">
                                                <GridViewColumnHeader Content="Allocated" Tag="Allocated"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Allocated}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="74">
                                                <GridViewColumnHeader Content="Items" Tag="Items"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Items}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="74">
                                                <GridViewColumnHeader Content="Files" Tag="Files"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Files}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="66">
                                                <GridViewColumnHeader Content="Folders" Tag="Folders"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Folders}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="122">
                                                <GridViewColumnHeader Content="Modified" Tag="Modified"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Modified}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="56">
                                                <GridViewColumnHeader Content="Attrib" Tag="Attributes"/>
                                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Attributes}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Category" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="{DynamicResource Muted}"/>
                                            <ComboBox x:Name="CategoryBox" SelectionChanged="Category_Changed"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="3" DockPanel.Dock="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ViewList" Style="{StaticResource Segment}" Content="List" IsChecked="True" Checked="ExtView_Changed"/>
                                                    <RadioButton x:Name="ViewPie" Style="{StaticResource Segment}" Content="Pie" Checked="ExtView_Changed"/>
                                                    <RadioButton x:Name="ViewDonut" Style="{StaticResource Segment}" Content="Donut" Checked="ExtView_Changed"/>
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="ClearExtButton" Style="{StaticResource SkiperLink}" Content="Clear filter" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Click="ClearExt_Click" IsEnabled="False"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <Grid>
                                        <ListView x:Name="ExtList" ItemContainerStyle="{StaticResource AnimatedRow}" SelectionMode="Single"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  SelectionChanged="ExtList_SelectionChanged">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="24">
                                                        <GridViewColumn.CellTemplate><DataTemplate><Border Width="11" Height="11" Background="{Binding Swatch}" CornerRadius="3.5"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Extension" Width="80">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Extension}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="File Type" Width="118">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FileType}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Percent" Width="62">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PercentText}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Size" Width="76">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size}" Style="{StaticResource Right}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Allocated" Width="76">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Allocated}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Files" Width="66">
                                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Files}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <ui:ExtChartControl x:Name="ExtChart" Visibility="Collapsed" Margin="4"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeNS"/>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                                    <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Click="Up_Click" Padding="8,4" ToolTip="Up one level">
                                        <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}"/>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Dimmed}" VerticalAlignment="Center" FontSize="11"
                                               Text="Click to select · Double-click to zoom in · Right-click for actions"/>
                                    <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Sep}" Foreground="{DynamicResource Dimmed}" Margin="4,0" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource SkiperLink}" Content="{Binding Name}" Tag="{Binding Index}" Click="Crumb_Click"/>
                                                    <StackPanel.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard><Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                            </Storyboard></BeginStoryboard>
                                                        </EventTrigger>
                                                    </StackPanel.Triggers>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <Border CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <ui:TreemapControl x:Name="Treemap">
                                            <ui:TreemapControl.ContextMenu><ContextMenu/></ui:TreemapControl.ContextMenu>
                                        </ui:TreemapControl>
                                        <Popup x:Name="TipPopup" PlacementTarget="{Binding ElementName=Treemap}" Placement="Relative" AllowsTransparency="True" IsHitTestVisible="False">
                                            <Border Background="{DynamicResource TipBg}" CornerRadius="10" Padding="12,8" MaxWidth="560" Margin="0,0,10,10" Effect="{StaticResource CardShadow}">
                                                <StackPanel>
                                                    <TextBlock x:Name="TipPath" Foreground="#F2F4F8" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="TipSize" Foreground="#D9DADC" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================= FILES ======================= -->
                <TabItem x:Name="TabFiles" Header="File View">
                    <Grid>
                        <!-- empty state: shown until a drive has been scanned -->
                        <Border x:Name="FilesEmpty" Panel.ZIndex="10" Style="{StaticResource Card}" Padding="40">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="36" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="FilesEmptyTitle" Text="See every file" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,8"/>
                                <TextBlock Text="Scan a drive to list all of its files, biggest first, with search and filters." Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                                <Button x:Name="FilesEmptyButton" Style="{StaticResource Primary}" Click="Scan_Click" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24,11">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,9,0"/><TextBlock Text="Scan drive" FontSize="14"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Grid Width="300">
                                <TextBox x:Name="SearchBox" Padding="34,7,10,7" TextChanged="FileFilter_Changed" ToolTip="Search file names (use * as a wildcard)"/>
                                <TextBlock Style="{StaticResource SearchIcon}"/>
                            </Grid>
                            <TextBlock Text="Size" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource Muted}"/>
                            <ComboBox x:Name="SizeFilter" Width="124" SelectionChanged="FileFilter_Changed"/>
                            <TextBlock Text="Modified" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{DynamicResource Muted}"/>
                            <ComboBox x:Name="DateFilter" Width="178" SelectionChanged="FileFilter_Changed"/>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FileCount" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" Text="Scan a drive first"/>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Card}" Padding="4">
                            <ListView x:Name="FileList" SelectionMode="Extended"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      GridViewColumnHeader.Click="FileHeader_Click" MouseDoubleClick="FileList_DoubleClick"
                                      KeyDown="FileList_KeyDown" ContextMenuOpening="FileList_ContextMenuOpening">
                                <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Dimmed}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="270">
                                            <GridViewColumnHeader Content="Name" Tag="Name"/>
                                            <GridViewColumn.CellTemplate><DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="90">
                                            <GridViewColumnHeader Content="Size" Tag="Size"/>
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size}" Style="{StaticResource Right}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="90">
                                            <GridViewColumnHeader Content="Allocated" Tag="Allocated"/>
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Allocated}" Style="{StaticResource Right}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="76" DisplayMemberBinding="{Binding Extension}"><GridViewColumnHeader Content="Ext" Tag="Ext"/></GridViewColumn>
                                        <GridViewColumn Width="124" DisplayMemberBinding="{Binding Modified}"><GridViewColumnHeader Content="Modified" Tag="Modified"/></GridViewColumn>
                                        <GridViewColumn Width="54" DisplayMemberBinding="{Binding Attributes}"><GridViewColumnHeader Content="Attrib" Tag="Attributes"/></GridViewColumn>
                                        <GridViewColumn Width="560">
                                            <GridViewColumnHeader Content="Folder" Tag="Folder"/>
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </DockPanel>
                </Grid>
                </TabItem>

                <!-- ======================= ORGANIZE FOLDER ======================= -->
                <TabItem x:Name="TabOrganize" Header="Organize">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <!-- empty state: no folder chosen yet -->
                        <Border x:Name="OrgEmpty" Grid.RowSpan="2" Panel.ZIndex="10" Style="{StaticResource Card}" Padding="40">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="36" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tidy up a messy folder" Style="{StaticResource H1}" FontSize="26" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                <TextBlock Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,8,0,0" FontSize="13.5"
                                           Text="Pick a folder like Downloads or Desktop. SpaceSift puts every file into a folder for its kind, named in plain words with its size, like &quot;Audio (5 GB)&quot; or &quot;Pictures (1.2 GB)&quot;. You can undo it."/>
                                <Button Style="{StaticResource Primary}" Click="OrgChoose_Click" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24,11">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" Margin="0,0,9,0"/><TextBlock Text="Choose a folder" FontSize="14"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- hero -->
                        <DockPanel x:Name="OrgHero" Margin="4,4,4,18" Visibility="Hidden">
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="OrgButton" Style="{StaticResource Primary}" Click="OrgRun_Click" IsEnabled="False" Margin="0" Padding="22,11" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" Margin="0,0,9,0"/><TextBlock x:Name="OrgButtonText" Text="Organize" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="OrgUndoButton" Style="{StaticResource Ghost}" Click="OrgUndo_Click" Visibility="Collapsed" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Undo"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" Click="OrgOpen_Click" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Open"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" Click="OrgChoose_Click" Margin="0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Choose another folder"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock x:Name="OrgHeadline" Text="0 files" FontFamily="{StaticResource DisplayFont}" FontSize="48" FontWeight="Bold"/>
                                    <TextBlock x:Name="OrgHeadSuffix" Text="to sort" FontSize="20" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,10"/>
                                </WrapPanel>
                                <TextBlock x:Name="OrgPath" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock x:Name="OrgSummary" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- one row per new folder -->
                        <Border x:Name="OrgListCard" Grid.Row="1" Style="{StaticResource Card}" Padding="6" Visibility="Hidden">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="OrgList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="12" Padding="14,11" Margin="2" Background="Transparent">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Surface2}" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="110">
                                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="11.5" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{DynamicResource FolderIcon}" Margin="0,0,7,0"/>
                                                            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="13.5"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Example}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================= CONVERT (Filee engine) ======================= -->
                <TabItem x:Name="TabConvert" Header="Convert">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="400"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <!-- drop zone: files dropped here open the format donut where they land -->
                        <Border x:Name="ConvertDrop" Style="{StaticResource Card}" AllowDrop="True" Background="{DynamicResource Surface}"
                                DragEnter="ConvertDrop_DragEnter" DragOver="ConvertDrop_DragEnter" DragLeave="ConvertDrop_DragLeave" Drop="ConvertDrop_Drop">
                            <Grid>
                                <Border x:Name="ConvertDropGlow" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Opacity="0" Margin="-1"/>
                                <StackPanel x:Name="ConvertDropContent" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                    <Border Width="92" Height="92" CornerRadius="46" Background="{DynamicResource Accent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" x:Name="ConvertBadge">
                                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="38" Foreground="Black" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Drop files to convert" Style="{StaticResource H1}" FontSize="26" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                    <TextBlock x:Name="ConvertHint" Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,8,0,0" FontSize="13.5"
                                               Text="Pictures, PDF, Word, Excel, PowerPoint, e-books, archives, video and audio. A ring of formats opens where you drop; pick one. The new file is saved next to the original, which is never changed."/>
                                    <Button Style="{StaticResource Primary}" Click="ConvertChoose_Click" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="24,11">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,9,0"/><TextBlock Text="Choose files" FontSize="14"/></StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,14,0,0" FontSize="11.5" Foreground="{DynamicResource Dimmed}"
                                               Text="Tip: right-click any file in Files or Disk Map and choose Convert. Tab or the mouse wheel flips the ring to more formats."/>
                                </StackPanel>
                                <!-- the format ring (Filee's donut) lives inside this card -->
                                <ui:DonutMenu x:Name="Donut" Dim="False" Visibility="Collapsed" ClipToBounds="True"/>
                            </Grid>
                        </Border>

                        <!-- recent conversions -->
                        <DockPanel Grid.Row="1" Margin="4,18,4,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="ConvertClear_Click" x:Name="ConvertClearButton" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Clear list"/></StackPanel>
                            </Button>
                            <TextBlock Text="Recent conversions" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" MaxHeight="260">
                            <Grid>
                                <TextBlock x:Name="ConvertEmpty" Text="Nothing converted yet." Foreground="{DynamicResource Muted}" Margin="14,12"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ConvertRecent">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" CornerRadius="12" Padding="12,9" Margin="2" Background="Transparent">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{Binding BadgeBrush}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource Ghost}" Click="ConvertOpen_Click" Tag="{Binding}" Visibility="{Binding OpenVisibility}" ToolTip="Open the new file">
                                                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}"/>
                                                            </Button>
                                                            <Button Style="{StaticResource Ghost}" Click="ConvertShow_Click" Tag="{Binding}" Visibility="{Binding OpenVisibility}" ToolTip="Show in Explorer">
                                                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================= ABOUT ======================= -->
                <TabItem Header="About">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" CornerRadius="18" ClipToBounds="True" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Border CornerRadius="18" Background="{DynamicResource HeroGlow}"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,24">
                                        <Image Source="Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SpaceSift Disk Studio" Style="{StaticResource H1}"/>
                                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Sub}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Follow Windows, or pick a theme. Your choice is remembered." Style="{StaticResource Sub}" Margin="0,2,0,12"/>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="Theme" Checked="ThemeMode_Checked" Tag="System">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="System"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Checked="ThemeMode_Checked" Tag="Light">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Light"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Checked="ThemeMode_Checked" Tag="Dark">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE708;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Dark"/></StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <Border Style="{StaticResource LiftCard}" Padding="18" Margin="0,0,7,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Clean Up" Style="{StaticResource H2}" Margin="0,10,0,4"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="Finds temp files, caches, crash dumps and the Recycle Bin. Safe items are ticked for you."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource LiftCard}" Padding="18" Margin="7,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Apps" Style="{StaticResource H2}" Margin="0,10,0,4"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="Uninstall programs, optionally with every folder they created, and find leftovers from removed apps."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource LiftCard}" Padding="18" Margin="0,0,7,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Disk Map" Style="{StaticResource H2}" Margin="0,10,0,4"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="Folder tree, file types and a treemap where every block is a file. Double-click to zoom in."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource LiftCard}" Padding="18" Margin="7,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Files" Style="{StaticResource H2}" Margin="0,10,0,4"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="Every file on the drive with search, size and date filters. Right-click anything for actions."/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Credits" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="Link hover animation ported from " VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource SkiperLink}" Content="Skiper UI · skiper40" Tag="https://skiper-ui.com" Click="ExternalLink_Click"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" (free version, attribution required)." VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Sub}" Text="File conversion engine and format-ring design from " VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource SkiperLink}" Content="Filee" Tag="https://github.com/KnifeLemon/Filee" Click="ExternalLink_Click"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" — MIT License, Copyright (c) Filee contributors. Its third-party libraries (ImageMagick, PDFsharp, SkiaSharp and others) keep their own licences; see " VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Style="{StaticResource SkiperLink}" Content="third-party notices" Tag="https://github.com/KnifeLemon/Filee/blob/main/THIRD-PARTY-NOTICES.md" Click="ExternalLink_Click"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="." VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Sub}" Text="Force delete eraser icon from " VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource SkiperLink}" Content="Font Awesome Free" Tag="https://fontawesome.com/license/free" Click="ExternalLink_Click"/>
                                        <TextBlock Style="{StaticResource Sub}" Text=" (CC BY 4.0)." VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
