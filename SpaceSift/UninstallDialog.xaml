<Window x:Class="SpaceSift.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall" Icon="Assets/app.ico" Width="640" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" BorderThickness="1.5" BorderBrush="{DynamicResource Line}" CornerRadius="14" Padding="14,12" Background="{DynamicResource Surface}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                                    <Ellipse Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSofter}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image x:Name="AppIcon" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock x:Name="SubText" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
        </StackPanel>

        <RadioButton x:Name="OptOnly" Style="{StaticResource OptionCard}" IsChecked="True" Checked="Option_Changed">
            <StackPanel>
                <TextBlock Text="Uninstall the program only" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="Runs the program's own uninstaller. Your settings and data folders are kept, in case you reinstall it later."/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="OptAll" Style="{StaticResource OptionCard}" Checked="Option_Changed">
            <StackPanel>
                <TextBlock x:Name="OptAllTitle" Text="Uninstall and remove all connected folders" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="After the uninstaller finishes, the folders below are moved to the Recycle Bin (you can still restore them). Untick anything you want to keep."/>
            </StackPanel>
        </RadioButton>

        <Border x:Name="ListBorder" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="12" MaxHeight="260" IsEnabled="False" Opacity="0.55">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,3">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Item.SizeText}" FontWeight="SemiBold" Width="80" TextAlignment="Right"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Item.Kind}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    <TextBlock Text="{Binding Item.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Path}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Visibility="Collapsed" Text="No connected folders were found for this program."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="OkButton" Click="Ok_Click" IsDefault="True" Style="{StaticResource DangerBtn}" Margin="0" Padding="18,8">
                <TextBlock x:Name="OkText" Text="Uninstall" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
