<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10: the Filee conversion engine (KnifeLemon/Filee) targets it -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 64-bit only, Windows 10 (1809+) and Windows 11 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Company>mercyblack011</Company>
    <Description>SpaceSift Disk Studio – find and free disk space on Windows</Description>
    <Copyright>Copyright © 2026 mercyblack011</Copyright>
    <AssemblyName>SpaceSift</AssemblyName>
    <RootNamespace>SpaceSift</RootNamespace>
    <Version>1.4.0</Version>
    <Product>SpaceSift Disk Analyzer</Product>

    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Smaller download, same features: SpaceSift's UI is English, so the 18 translated .NET/WPF message
         folders (cs, de, ja …, ~9 MB) aren't shipped, and package debug symbols (.pdb) aren't copied. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <Target Name="DropPackageSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\mark.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    File conversion: Filee's engine (MIT, https://github.com/KnifeLemon/Filee), built from source.
    build\fetch-filee.ps1 puts the pinned version in a short folder (Filee's paths are deep, and Windows
    limits paths to 260 characters). Override with -p:FileeRoot=<folder>.
  -->
  <PropertyGroup>
    <FileeRoot Condition="'$(FileeRoot)' == ''">$(LOCALAPPDATA)\SpaceSift.build\Filee</FileeRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FileeRoot)\src\Filee.Core\Filee.Core.csproj" />
    <ProjectReference Include="$(FileeRoot)\src\Filee.Engines\Filee.Engines.csproj" />
    <!-- English error messages and format names from Filee's translation file -->
    <EmbeddedResource Include="$(FileeRoot)\src\Filee.App\Assets\i18n\en.json" LogicalName="SpaceSift.filee.en.json" />
  </ItemGroup>
  <Target Name="CheckFilee" BeforeTargets="ResolveProjectReferences" Condition="!Exists('$(FileeRoot)\src\Filee.Engines\Filee.Engines.csproj')">
    <Error Text="The Filee conversion engine is missing. Run: powershell -File build\fetch-filee.ps1" />
  </Target>

</Project>
